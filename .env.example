# Postgres — app role is NOT a superuser so row-level security is enforced.
DATABASE_URL=postgres://zfunnel_app:zfunnel_app@localhost:5432/zfunnel
REDIS_URL=redis://localhost:6379

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public renderer: funnels are served on {slug}.ROOT_DOMAIN
ROOT_DOMAIN=localhost:3001

# Mailpit (local SMTP catcher)
SMTP_URL=smtp://localhost:1025

# Integration tests (row-level security). Must be a non-superuser role.
TEST_DATABASE_URL=postgres://zfunnel_app:zfunnel_app@localhost:5432/zfunnel_test

# Built-in test gateway so funnels can be tried before connecting Stripe
PAYMENTS_TEST_MODE=false

# Stripe Connect (platform keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Custom domains: where customers point DNS
SITES_CNAME_TARGET=sites.zfunnel.app
SITES_IPV4=

# AI copywriter (optional). Without a key the AI buttons explain that AI is not set up.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
