# Postgres — app role is NOT a superuser so row-level security is enforced.
DATABASE_URL=postgres://zfunnel_app:zfunnel_app@localhost:5432/zfunnel
REDIS_URL=redis://localhost:6379

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public renderer: funnels are served on {slug}.ROOT_DOMAIN
ROOT_DOMAIN=localhost:3001

# Mailpit (local SMTP catcher)
SMTP_URL=smtp://localhost:1025

# Integration tests (row-level security). Must be a non-superuser role.
TEST_DATABASE_URL=postgres://zfunnel_app:zfunnel_app@localhost:5432/zfunnel_test
