{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "DATABASE_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NODE_ENV",
    "PAYMENTS_TEST_MODE",
    "REDIS_URL",
    "ROOT_DOMAIN",
    "SITES_CNAME_TARGET",
    "SITES_IPV4",
    "STRIPE_MOCK",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    }
  }
}
