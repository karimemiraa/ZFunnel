# Copy to infra/deploy/.env on the server and fill in. Never commit the real file.

# Your platform domain: dashboard at app.ROOT_DOMAIN, free funnels at {slug}.ROOT_DOMAIN
ROOT_DOMAIN=zfunnel.example.com
ACME_EMAIL=admin@example.com
# Public IPv4 of the server (shown to customers for apex-domain A records)
SERVER_IPV4=

# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
ANALYTICS_SALT=
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_APP_PASSWORD=

# Stripe Connect (platform account). Leave empty to run in test mode only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the "Events on your account" endpoint (ZFunnel plan subscriptions).
STRIPE_PLATFORM_WEBHOOK_SECRET=
PAYMENTS_TEST_MODE=false

# Only change if another proxy already uses 80/443 on this server (see docs/DEPLOYMENT.md)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# AI copywriter (optional). Without a key the AI buttons explain that AI is not set up.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# Email sending (required for broadcasts, automations and customer sign-in links).
# Use your provider's SMTP URL, e.g. smtps://USER:PASSWORD@smtp.postmarkapp.com:465
SMTP_URL=
# Sender address; its domain must be verified with your provider (SPF/DKIM).
EMAIL_FROM=hello@mail.example.com

# Key for encrypting stored third-party credentials (Twilio, Meta, TikTok, GA4 tokens).
# Defaults to BETTER_AUTH_SECRET. Set it once and keep it: changing it makes saved tokens
# unreadable (owners would have to re-enter them).
# SECRETS_KEY=
